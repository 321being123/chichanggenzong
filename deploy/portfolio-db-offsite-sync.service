[Unit]
Description=Portfolio encrypted backup offsite sync
After=network-online.target portfolio-db-backup.service
Wants=network-online.target
OnFailure=portfolio-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/portfolio
EnvironmentFile=/opt/portfolio/.env
EnvironmentFile=/etc/portfolio/backup.env
Environment=BACKUP_DIR=/var/backups/portfolio
ExecStart=/usr/bin/env bash /opt/portfolio/scripts/sync_encrypted_backups.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/portfolio /var/lib/portfolio-backup
TimeoutStartSec=30m
