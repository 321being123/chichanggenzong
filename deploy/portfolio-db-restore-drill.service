[Unit]
Description=Portfolio isolated PostgreSQL restore drill
After=postgresql.service
Wants=postgresql.service
OnFailure=portfolio-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/portfolio
EnvironmentFile=/opt/portfolio/.env
EnvironmentFile=/etc/portfolio/backup.env
Environment=BACKUP_DIR=/var/backups/portfolio
Environment=RESTORE_DRILL_KEEP_DATABASE=0
Environment=GNUPGHOME=/var/lib/portfolio-backup/gnupg
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /var/lib/portfolio-backup/gnupg
ExecStart=/usr/bin/env bash /opt/portfolio/scripts/restore_backup_drill.sh
ExecStartPost=/usr/bin/node /opt/portfolio/server/scripts/sendBackupFailureAlert.js --resolve portfolio-db-restore-drill.service
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/portfolio /var/lib/portfolio-backup
TimeoutStartSec=90m
