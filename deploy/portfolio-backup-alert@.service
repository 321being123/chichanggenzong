[Unit]
Description=Portfolio backup failure alert for %i

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/portfolio
EnvironmentFile=/opt/portfolio/.env
EnvironmentFile=/etc/portfolio/backup.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/portfolio/server/scripts/sendBackupFailureAlert.js %i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/portfolio-backup
TimeoutStartSec=2m
