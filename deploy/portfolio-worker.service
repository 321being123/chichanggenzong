[Unit]
Description=持仓管理系统 后台任务 Worker
After=network.target postgresql.service

[Service]
Type=simple
User=portfolio-app
WorkingDirectory=/opt/portfolio
# 敏感信息（PG / SECRET 等）由应用通过 dotenv 读取 /opt/portfolio/.env，此处不硬编码
Environment=NODE_ENV=production
Environment=DURABLE_SCHEDULER=1
Environment=WORKER_DRAIN_TIMEOUT_MS=60000
# worker 进程承担全部后台调度（server/scheduler.js 单一注册表）；切勿设 DISABLE_SCHEDULER
ExecStart=/usr/bin/node /opt/portfolio/server/worker.js
TimeoutStopSec=50min
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
# Worker 仅写运行时数据、报告、模型和休市日历，禁止改写代码与 .git。
ReadWritePaths=/opt/portfolio/data /opt/portfolio/ipo-report/data /opt/portfolio/ipo-report/history_reports /opt/portfolio/ipo-report/individual /opt/portfolio/server/config/holidays.json
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
