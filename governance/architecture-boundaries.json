  "globalContracts": {
    "status": "first-batch",
    "scope": "股票分析样板、主站外壳、公开分享入口及其实际依赖闭包；其余页面随批次4补齐",
    "surfaces": [
      {
        "id": "site-shell",
        "page": "public/index.html",
        "contractStatus": "registered",
        "batch": 2,
        "note": "主站外壳脚本顺序与共享依赖；精细符号随批次2/4逐个补齐，不一次登记全部页面符号"
      },
      {
        "id": "public-share",
        "template": "server/views/share.html",
        "contractStatus": "registered",
        "batch": 4,
        "noInlineScript": true,
        "noInlineStyle": true,
        "note": "公开分享页模板放 server/views，零内联脚本与样式；分享复用同一 View，不复制渲染器"
      }
    ],
    "providers": [
      {
        "symbol": "stockAnalysisState",
        "kind": "variable",
        "file": "public/js/stock-analysis.js",
        "consumers": [
          "public/js/stock-analysis.js",
