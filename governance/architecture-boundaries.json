{
  "schemaVersion": 1,
  "lastReviewed": "2026-10-27",
  "rulesVersion": "layer-coupling-3",
  "defaultRole": "pending_contract",
  "scan": {
    "includeExtensions": [".js", ".py"],
    "excludePaths": [
      "node_modules/",
      ".worktrees/",
      "server/test/",
      "test/",
      "backups/",
      "data/",
      "server/data/",
      "ipo-report/data/",
      "runtime/",
      "public/vendor/",
      "_deprecated/",
      "_probe/",
      "outputs/",
      "deploy/"
    ],
    "excludeSegments": ["node_modules", "venv", "__pycache__"],
    "excludeFilePatterns": ["^test[._-]", "\\.test\\.js$", "^_tmp", "^debug_", "^_probe"]
  },
  "roles": {
    "route": {
      "description": "HTTP 协议适配与鉴权上下文转交",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "job": {
      "description": "任务/计划编排与执行上下文",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "application": {
      "description": "用例编排与事务协调",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "domain": {
      "description": "业务模型与金融规则，输入标准事实",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "repository": {
      "description": "标准事实仓储与事务实现",
      "allowSql": true,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "data_access": {
      "description": "数据访问与统一读取投影",
      "allowSql": true,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "data_adapter": {
      "description": "外部来源适配与归一化，唯一外采落点",
      "allowSql": false,
      "allowNetwork": true,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "data_prep": {
      "description": "数据准备/采集脚本（Python），允许 SQL 与联网",
      "allowSql": true,
      "allowNetwork": true,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "domain_algorithm": {
      "description": "算法/模型模块，禁止数据库与联网",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "script_cli": {
      "description": "CLI、诊断与一次性数据脚本",
      "allowSql": true,
      "allowNetwork": true,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "migration": {
      "description": "数据库迁移脚本",
      "allowSql": true,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "infrastructure": {
      "description": "连接池、Guard、会话、遥测、租约等基础设施",
      "allowSql": true,
      "allowNetwork": true,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "config": {
      "description": "启动入口与应用装配",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "view": {
      "description": "DOM/图表渲染、格式化与交互上报",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": true,
      "newFilesAllowed": true
    },
    "presenter": {
      "description": "请求协调、页面状态与响应序号",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "api_client": {
      "description": "站内 HTTP 客户端与错误归一",
      "allowSql": false,
      "allowNetwork": true,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "shared_pure": {
      "description": "Node/浏览器同一份业务纯函数（按 5.3 逐符号窄许可调用）",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": true
    },
    "frontend_infrastructure": {"description":"前端基础设施（遥测、懒加载、UI 动作、移动端壳），允许 DOM 与网络","allowSql":false,"allowNetwork":true,"allowDom":true,"newFilesAllowed":true},
    "shared_render": {
      "description": "可复用渲染与交互组件",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": true,
      "newFilesAllowed": true
    },
    "service_legacy": {
      "description": "存量服务：业务、取数与缓存编排混用，待按批次迁出",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": false,
      "newFilesAllowed": false,
      "legacy": true
    },
    "frontend_legacy": {
      "description": "存量页面脚本：请求、状态与 DOM 混用，待拆 Presenter/View",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": true,
      "newFilesAllowed": false,
      "legacy": true
    },
    "pending_contract": {
      "description": "未登记职责，不得据此声称已实现分层",
      "allowSql": false,
      "allowNetwork": false,
      "allowDom": true,
      "newFilesAllowed": false,
      "legacy": true
    }
  },
  "sqlAllowedRoles": ["repository", "data_access", "data_prep", "script_cli", "migration", "infrastructure"],
