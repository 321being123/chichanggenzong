[Unit]
Description=持仓管理系统 Web 服务
After=network.target postgresql.service

[Service]
Type=simple
User=portfolio-app
WorkingDirectory=/opt/portfolio
# 敏感信息（PG / SECRET 等）由应用通过 dotenv 读取 /opt/portfolio/.env，此处不硬编码
Environment=NODE_ENV=production
# Web 进程固定关闭后台调度，全部后台任务由独立 worker 进程承担（见 portfolio-worker.service）
Environment=DISABLE_SCHEDULER=1
Environment=DISABLE_RUNTIME_MIGRATIONS=1
ExecStart=/usr/bin/node /opt/portfolio/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
# 仅允许运行时数据、报告和模型写入；Git 内休市日历仅作为只读种子。
ReadWritePaths=/opt/portfolio/data /var/lib/portfolio/models/ipo /opt/portfolio/ipo-report/data /opt/portfolio/ipo-report/history_reports /opt/portfolio/ipo-report/individual
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
