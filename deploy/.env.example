# ===== 持仓管理系统 环境变量模板 =====
# 复制本文件为 .env 后，按需填写（.env 已被 .gitignore 忽略，不会上传）
# 应用启动时会通过 dotenv 自动读取本文件（放到项目根目录，与 server.js 同级）

# 服务监听端口（Nginx 反代会指向这个内部端口，公网无需开放）
PORT=3000

# 官方 Nginx 与应用位于同一台服务器，仅信任本机反向代理。
TRUST_PROXY=loopback

# 会话密钥：生产环境务必改成一个随机长字符串（可用 `openssl rand -hex 32` 生成）
# 若 data/.secret 已存在且非空，则此处留空也会自动沿用
SECRET=

# 允许的请求来源（部署公网后必填，多个用逗号分隔，只写域名，不要带 http/端口）
# 本地默认：localhost,127.0.0.1
# 上线后改为你的域名，例如：myapp.com,www.myapp.com
ALLOWED_ORIGIN=localhost,127.0.0.1

# 注册邀请码：设置后，新用户注册必须填此码；不设置则任何人可自助注册
# 公网部署强烈建议设置一个
REGISTER_CODE=

# ===== 可选 Redis（公网多用户强烈建议） =====
# 填了 REDIS_URL，会话会存到 Redis（重启不掉登录、多进程共享），
# 并对 AI 识别/数据保存等接口启用分布式限流；不填则退回内存模式（当前单机行为）。
# 格式：redis://:密码@主机:6379
# REDIS_URL=

# ===== PostgreSQL 连接（二选一） =====
# 方式A：完整连接串（优先）。例如 postgres://用户名:密码@主机:5432/库名
DATABASE_URL=postgres://postgres:密码@localhost:5432/portfolio
# 方式B：分项变量（未设置 DATABASE_URL 时生效）
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
# PGPASSWORD 必填强密码：既是应用连库密码，也用于拼接应用的 DATABASE_URL。
# 生产环境切勿用 postgres 之类弱密码（可用 `openssl rand -hex 24` 生成）。
PGPASSWORD=
PGDATABASE=portfolio
# 如数据库启用 SSL（云数据库常见），设 true；本地一般 false
PGSSL=false

# ===== Tushare Pro 官方金融数据 =====
# 直连官方接口：https://api.tushare.pro（POST JSON）
TUSHARE_TOKEN=

# ===== AI视觉识别（图片识别交易截图） =====
# 使用的视觉大模型 API（OpenAI 兼容格式）
VISION_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
VISION_MODEL=agnes-1.5-flash
VISION_API_KEY=你的API密钥

# ===== SMTP 邮件服务 =====
# 可复用注册验证码邮件配置。密码只能保存在实际 .env，禁止提交到 Git。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===== 后台任务邮件告警 =====
# 多个收件人用英文逗号分隔；留空则不发送任务告警。
ALERT_EMAIL_TO=
# 可选；留空时使用“存在小站任务告警 <SMTP_USER>”作为发件人。
ALERT_EMAIL_FROM=
# 用于邮件标题区分环境，本地默认 development，生产设 production。
ALERT_ENVIRONMENT=development
# 设为 0 可临时关闭计划观察器（不影响旧任务调度）；默认开启。
DURABLE_SCHEDULER=1
