{
  "schemaVersion": 1,
  "lastReviewed": "2026-09-19",
  "rules": [
    {
      "id": "TASK-CONTRACT-001",
      "title": "默认值合并前审计原始任务契约",
      "implementation": { "file": "server/services/jobDefinitions.js", "symbol": "validateJobDefinitionSources" },
      "tests": [{ "file": "server/test/ops-alert-remediation-regression.test.js", "pattern": "validateJobDefinitionSources" }],
      "owner": "任务治理",
      "status": "verified"
    },
    {
      "id": "TASK-CONTRACT-002",
      "title": "任务契约键冲突、孤儿键和硬依赖必须失败",
      "implementation": { "file": "server/services/jobDefinitions.js", "symbol": "JOB_CONTRACTS" },
      "tests": [{ "file": "server/test/ops-alert-remediation-regression.test.js", "pattern": "strict: true" }],
      "owner": "任务治理",
      "status": "verified"
    },
    {
      "id": "TASK-DATE-001",
      "title": "数据集依赖统一消费 partitionDatePolicy",
      "implementation": { "file": "server/services/jobScheduleSlots.js", "symbol": "resolveDatasetPartitionDate" },
      "tests": [{ "file": "server/test/ops-alert-remediation-regression.test.js", "pattern": "previous_trading_day" }, { "file": "server/test/inc-0010-regression.test.js", "pattern": "datasetDependencyState" }],
      "owner": "任务治理",
      "status": "verified"
    },
    {
      "id": "TASK-DATE-002",
      "title": "未知任务不得进入执行和恢复链路",
      "implementation": { "file": "server/services/jobDefinitions.js", "symbol": "getRegisteredJobDefinition" },
      "tests": [{ "file": "server/test/ops-alert-remediation-regression.test.js", "pattern": "unknown_job_definition" }],
      "owner": "任务治理",
      "status": "verified"
    },
    {
      "id": "ALERT-EVIDENCE-001",
      "title": "告警类型必须有证据策略注册",
      "implementation": { "file": "server/services/jobAlertMailer.js", "symbol": "ALERT_EVIDENCE_POLICIES" },
      "tests": [{ "file": "server/test/ops-alert-remediation-regression.test.js", "pattern": "unknown_alert_type_requires_manual_review" }],
      "owner": "运维治理",
      "status": "verified"
    },
    {
      "id": "ALERT-EVIDENCE-002",
      "title": "具体来源接口不得使用 source:* 作为恢复证据",
      "implementation": { "file": "server/services/jobAlertMailer.js", "symbol": "verifyAlertScope" },
      "tests": [{ "file": "server/test/ops-alert-remediation-regression.test.js", "pattern": "wildcardMustNotRecoverConcrete" }],
      "owner": "运维治理",
      "status": "verified"
    },
    {
      "id": "ALERT-EVIDENCE-003",
      "title": "依赖阻塞恢复必须复用严格槽位证据",
      "implementation": { "file": "server/services/jobRecoveryEvidence.js", "symbol": "verifySlotRecoveryEvidence" },
      "tests": [{ "file": "server/test/ops-alert-remediation-regression.test.js", "pattern": "dependencyAlert" }],
      "owner": "运维治理",
      "status": "verified"
    },
    {
      "id": "GOVERNANCE-001",
      "title": "任务治理规则必须进入知识门禁",
      "implementation": { "file": "scripts/check-knowledge.js", "symbol": "collectJobContractErrors" },
      "tests": [{ "file": "server/test/knowledge-governance.test.js", "pattern": "runCheck" }],
      "owner": "研发规范",
      "status": "verified"
    },
    {
      "id": "TASK-DATASET-003",
      "title": "分阶段任务必须按阶段契约发布并核对分区",
      "implementation": { "file": "server/services/datasetPartitionRegistry.js", "symbol": "publishJobDatasets" },
      "tests": [{ "file": "server/test/dataset-publication-contract.test.js", "pattern": "IPO 阶段和分区作用域契约通过" }],
      "owner": "任务治理",
      "status": "verified"
    },
    {
      "id": "ALERT-EVIDENCE-004",
      "title": "告警只针对本槽位声明且实际尝试的数据集",
      "implementation": { "file": "server/services/jobOrchestrator.js", "symbol": "buildDatasetDiagnosticAlerts" },
      "tests": [{ "file": "server/test/hk-ipo-diagnostics-alert.test.js", "pattern": "未获准入且本轮未请求的动态源不能产生故障告警" }],
      "owner": "运维治理",
      "status": "verified"
    },
    {
      "id": "TASK-SLOT-003",
      "title": "计划内不同槽位成功不互相触发重复告警",
      "implementation": { "file": "server/services/jobOrchestrator.js", "symbol": "finishManagedRun" },
      "tests": [{ "file": "server/test/job-execution-protection.test.js", "pattern": "同一计划槽位重复成功必须告警" }],
      "owner": "任务治理",
      "status": "verified"
    },
    {
      "id": "HK-IPO-SOURCE-001",
      "title": "未准入港股动态源不得联网采集",
      "implementation": { "file": "server/services/hkIpoMarketSignals.js", "symbol": "syncHkIpoMarketSignals" },
      "tests": [{ "file": "server/test/hk-ipo-dynamic-source-admission.test.js", "pattern": "默认未准入状态必须在联网和读取动态信号数据库前安全返回" }],
      "owner": "港股 IPO",
      "status": "verified"
    },
    {
      "id": "HOLDINGS-CROSS-MARKET-001",
      "title": "港股交易状态及收盘时刻必须来自明确 HKEX 日历事实",
      "implementation": { "file": "server/services/marketState.js", "symbol": "deriveMarketState" },
      "tests": [{ "file": "server/test/cross-market-calendar-nav.test.js", "pattern": "半日盘 12:05 收市竞价期间仍属交易时段" }],
      "owner": "持仓管理",
      "status": "verified"
    },
    {
      "id": "HOLDINGS-NAV-002",
      "title": "跨市场账户价格和汇率变动须在同日净值归因闭合",
      "implementation": { "file": "server/services/navAttribution.js", "symbol": "computeNavAttribution" },
      "tests": [{ "file": "server/test/cross-market-calendar-nav.test.js", "pattern": "港股单独开市时归因必须完整" }],
      "owner": "持仓管理",
      "status": "verified"
    },
    {
      "id": "HOLDINGS-REFRESH-003",
      "title": "港股开市时刷新须即时更新持仓页与首页总资产",
      "implementation": { "file": "public/shared/core-quote.js", "symbol": "refreshAllPrices" },
      "tests": [{ "file": "server/test/holdings-cross-market-refresh.test.js", "pattern": "持仓页总资产应在 PATCH 完成前显示 4002 元" }],
      "owner": "持仓管理",
      "status": "verified"
    }
  ]
}
