# 安装到生产服务器 /etc/portfolio/backup.env，权限必须为 root:root 0600。
# 使用高强度随机口令；不得提交真实口令，不得与应用 SECRET 共用。
BACKUP_PASSPHRASE=

# 异地对象存储（默认关闭；配置真实 COS/S3 兼容地址和密钥后再改为 1）。
# 只上传 .gpg 与 .sha256，明文 .sql/.sql.gz 会被同步脚本拒绝。
BACKUP_OFFSITE_ENABLED=0
BACKUP_STORAGE_PROVIDER=s3
BACKUP_STORAGE_URI=s3://bucket-name/portfolio
BACKUP_STORAGE_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 隔离恢复演练：默认每月运行后删除临时库。
RESTORE_DRILL_KEEP_DATABASE=0
