  "batchScopeTemplate": {
    "note": "批次1—5 各小批开工前在其唯一任务卡按本格式冻结范围；本文件只给格式与候选，不冒充正式名单。",
    "requiredSections": [
      {
        "key": "mustMigrate",
        "label": "本批必迁",
        "fields": ["path", "symbols", "targetRole", "contractIds", "removesViolationIds"],
        "rule": "按具体文件和符号冻结，不将整个 service 文件默认迁移；必须有真实调用切换，不能只新增未使用接口"
      },
      {
        "key": "reuseVerified",
        "label": "复用验证、不重写",
        "fields": ["path", "interface", "unchangedBoundary"],
        "rule": "确需修改时先改列本批必迁，不能藏在复用里"
      },
      {
        "key": "notMigrated",
        "label": "本批不迁的存量",
        "fields": ["path", "violationIds", "nextBatch", "owner"],
        "rule": "写明后续批次和责任位置，不标成已分离，也不成为永久豁免"
      }
    ]
  },
  "layerRules": {
    "note": "跨层引用与 DOM 禁令。domain 不得依赖任何外层实现；仓储不得被路由/任务反向依赖；presenter 不得引用 view 或操作 DOM。仓储依赖 domain 的纯常量/纯函数属依赖倒置，允许。",
    "forbiddenImports": {
      "domain": ["repository", "data_access", "data_adapter", "route", "job", "application", "service_legacy", "config", "infrastructure"],
      "domain_algorithm": ["repository", "data_access", "data_adapter", "route", "job", "application", "service_legacy", "config", "infrastructure"],
      "repository": ["route", "job", "application", "service_legacy", "config"],
